AZURE_STORAGE_ACCOUNT_PRIMARY_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-storage-account;AccountKey=your-storage-account-key;EndpointSuffix=core.windows.net
AZURE_CONTAINER_STORAGE_NAME=dsl-bot-logs
AZURE_CONTAINER_STORAGE_SECRETS_NAME=dsl-bot-secrets
AZURE_CONTAINER_STORAGE_ETL_FILES_NAME=dsl-bot-etl-files
AZURE_CUSTOMER_REGISTRY_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
AZURE_CUSTOMER_REGISTRY_MANIFEST_CONTAINER=customer-registry
AZURE_CUSTOMER_REGISTRY_CONTAINER_PREFIX=customer-registry-

# Azure infrastructure
AZURE_ETL_RESOURCE_GROUP_NAME=rg-db-etl-001
AZURE_CONTAINER_REGISTRY_NAME=your-registry
AZURE_CONTAINER_REGISTRY_LOGIN_SERVER=your-registry.azurecr.io
AZURE_RESOURCE_GROUP_LOCATION=switzerlandnorth
AZURE_CONTAINER_APP_ENV_NAME=cae-db-etl-001

# Notification (optional, for smoke test results)
WEBHOOK_URL=https://outlook.office.com/webhook/...

# Closer User Group authentication
BNF_BASIC_AUTH_USER=your_username
BNF_BASIC_AUTH_PASSWORD=your_password